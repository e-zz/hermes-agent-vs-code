diff --git a/lib/node-runtime.js b/lib/node-runtime.js
index 3504901..3aad645 100644
--- a/lib/node-runtime.js
+++ b/lib/node-runtime.js
@@ -6,7 +6,7 @@ const path = require("path");
 const { spawn } = require("child_process");
 
 const DEFAULT_TIMEOUT_MS = 3000;
-const APPLICATION_RUNTIME_PATTERN = /(?:code helper|visual studio code|electron)/i;
+const APPLICATION_RUNTIME_PATTERN = /(?:code helper|visual studio code|electron|(?:^|[\\/])code(?: - insiders)?\.exe$)/i;
 
 class NodeRuntimeError extends Error {
   constructor(message, { code = "NODE_RUNTIME_ERROR", failures = [] } = {}) {
@@ -24,12 +24,11 @@ function normalizedPath(value) {
     : resolved;
 }
 
-function samePath(left, right) {
-  if (!left || !right) return false;
-  return normalizedPath(left) === normalizedPath(right);
-}
-
 function validateProbeResult(runtime, currentExecPath = process.execPath) {
+  // `currentExecPath` is retained for backwards compatibility with callers that
+  // pass it positionally; it is no longer used to disqualify a candidate. See the
+  // note at the end of this function for why identity is not disqualifying.
+  void currentExecPath;
   if (!runtime || !/^\d+\.\d+(?:\.\d+)?/.test(String(runtime.nodeVersion || ""))) {
     throw new Error("Executable did not report a valid Node.js version");
   }
@@ -44,9 +43,17 @@ function validateProbeResult(runtime, currentExecPath = process.execPath) {
   if (APPLICATION_RUNTIME_PATTERN.test(executablePath) || APPLICATION_RUNTIME_PATTERN.test(realPath)) {
     throw new Error("VS Code or Electron executables cannot own the Hermes background host");
   }
-  if (samePath(realPath, currentExecPath) || samePath(executablePath, currentExecPath)) {
-    throw new Error("The extension host executable cannot own the Hermes background host");
-  }
+  // NOTE: a check that rejected any candidate whose path equals the current
+  // process's execPath used to live here. It was removed because it could only
+  // ever fire on a genuine standalone Node.js runtime: VS Code's Code.exe and
+  // Electron binaries never reach this point at all (Code.exe emits no parseable
+  // probe response, and electronVersion is rejected above — probeNodeRuntime also
+  // deletes ELECTRON_RUN_AS_NODE so an Electron binary cannot impersonate Node).
+  // When VS Code's extension host itself is launched with system Node, that Node
+  // *is* the correct background host, and the old check rejected it, producing
+  // "A validated standalone Node.js runtime is required for the Hermes background
+  // host" with no valid candidate left. The probe-based checks above already
+  // establish the candidate is a real Node runtime, so identity is not disqualifying.
   return runtime;
 }
 
